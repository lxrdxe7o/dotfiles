layout {

    focus-ring {
        active-color   "#ffb2bd"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb2bd"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb2bd"
        inactive-color "#7d293c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb2bd80"
    }
}
