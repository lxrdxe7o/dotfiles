 /* wallust template - colors-rofi */

* {
active-background: #44A5D2;
active-foreground: #F6FBFD;
normal-background: #1B1D21;
normal-foreground: #F6FBFD;
urgent-background: #46AAD8;
urgent-foreground: #F6FBFD;

alternate-active-background: #2D6D8D;
alternate-active-foreground: #F6FBFD;
alternate-normal-background: #1B1D21;
alternate-normal-foreground: #F6FBFD;
alternate-urgent-background: #1B1D21;
alternate-urgent-foreground: #F6FBFD;

selected-active-background: #46AAD8;
selected-active-foreground: #F6FBFD;
selected-normal-background: #46AAD8;
selected-normal-foreground: #F6FBFD;
selected-urgent-background: #44A5D2;
selected-urgent-foreground: #F6FBFD;

background-color: #1B1D21;
background: rgba(0,0,0,0.7);
foreground: #F6FBFD;
border-color: #44A5D2;

color0: #414449;
color1: #4A0D59;
color2: #1B4357;
color3: #21526A;
color4: #337C9D;
color5: #3580A2;
color6: #ABB7BA;
color7: #E9F1F3;
color8: #A3A9AA;
color9: #621176;
