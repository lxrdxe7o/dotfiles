 /* wallust template - colors-rofi */

* {
active-background: #9B4B5B;
active-foreground: #EEE5DA;
normal-background: #302F2F;
normal-foreground: #EEE5DA;
urgent-background: #83807D;
urgent-foreground: #EEE5DA;

alternate-active-background: #7A424D;
alternate-active-foreground: #EEE5DA;
alternate-normal-background: #302F2F;
alternate-normal-foreground: #EEE5DA;
alternate-urgent-background: #302F2F;
alternate-urgent-foreground: #EEE5DA;

selected-active-background: #83807D;
selected-active-foreground: #EEE5DA;
selected-normal-background: #83807D;
selected-normal-foreground: #EEE5DA;
selected-urgent-background: #9B4B5B;
selected-urgent-foreground: #EEE5DA;

background-color: #302F2F;
background: rgba(0,0,0,0.7);
foreground: #EEE5DA;
border-color: #9B4B5B;

color0: #545454;
color1: #252322;
color2: #2A2525;
color3: #5B323A;
color4: #743844;
color5: #62605E;
color6: #9A8970;
color7: #DED2C2;
color8: #9B9387;
color9: #312F2E;
color10: #383131;
color11: #7A424D;
