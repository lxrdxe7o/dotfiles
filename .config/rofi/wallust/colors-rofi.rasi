active-foreground: #F3EDE5;
normal-background: #121212;
normal-foreground: #F3EDE5;
urgent-background: #D6C3AD;
urgent-foreground: #F3EDE5;

alternate-active-background: #5A5754;
alternate-active-foreground: #F3EDE5;
