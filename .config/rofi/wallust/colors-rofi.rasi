 /* wallust template - colors-rofi */

* {
active-background: #8B8E9C;
active-foreground: #F4ECBF;
normal-background: #272327;
normal-foreground: #F4ECBF;
urgent-background: #8B8E9C;
urgent-foreground: #F4ECBF;

alternate-active-background: #D64D4E;
alternate-active-foreground: #F4ECBF;
alternate-normal-background: #272327;
alternate-normal-foreground: #F4ECBF;
alternate-urgent-background: #272327;
alternate-urgent-foreground: #F4ECBF;

