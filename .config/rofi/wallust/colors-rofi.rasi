 /* wallust template - colors-rofi */

* {
active-background: #AB3826;
active-foreground: #F2BBB2;
normal-background: #1F1D1D;
normal-foreground: #F2BBB2;
urgent-background: #DA3C24;
urgent-foreground: #F2BBB2;

alternate-active-background: #813024;
alternate-active-foreground: #F2BBB2;
alternate-normal-background: #1F1D1D;
alternate-normal-foreground: #F2BBB2;
alternate-urgent-background: #1F1D1D;
alternate-urgent-foreground: #F2BBB2;

selected-active-background: #DA3C24;
selected-active-foreground: #F2BBB2;
selected-normal-background: #DA3C24;
selected-normal-foreground: #F2BBB2;
selected-urgent-background: #AB3826;
selected-urgent-foreground: #F2BBB2;

background-color: #1F1D1D;
background: rgba(0,0,0,0.7);
foreground: #F2BBB2;
border-color: #AB3826;

color0: #454443;
color1: #1B1615;
color2: #441D18;
color3: #61241B;
color4: #812A1C;
color5: #A32D1B;
color6: #A42D1B;
color7: #E49589;
color8: #A06860;
color9: #251D1C;
color10: #5B2720;
color11: #813024;
color12: #AB3826;
color13: #DA3C24;
color14: #DA3C24;
color15: #E49589;


}

